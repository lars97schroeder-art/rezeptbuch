      "images": [
        "data/images/spaghetti-carbonara-1783240941.jpg"
      ],
      "ingredients": [
        "250 g Spaghetti",
        "1 Rewe Bio Bacon (2 wären besser 😏)",
        "3 Eigelb + 1 ganz",
        "60 g Pecorino",
        "60 g Parmesan",
        "Schwarzer Pfeffer",
        "Salz"
      ],
      "steps": [
        "Spaghetti in reichlich Salzwasser al dente kochen",
        "Eine Tasse Pasta Wasser an die Seite",
        "Bacon in der Pfanne knusprig auslassen.",
