    {
      "id": "spaghetti-carbonara",
      "title": "Spaghetti Carbonara",
      "category": "Pasta & Gnocchi",
      "time": "25 Min.",
      "servings": "2 Portionen",
      "image": "",
      "ingredients": [
        "250 g Spaghetti",
        "100 g Guanciale oder Pancetta",
        "2 Eier + 1 Eigelb",
        "60 g Pecorino, gerieben",
        "Schwarzer Pfeffer",
        "Salz"
      ],
      "steps": [
        "Spaghetti in reichlich Salzwasser al dente kochen.",
        "Guanciale in Würfel schneiden und in der Pfanne knusprig auslassen.",
        "Eier, Eigelb und Pecorino mit viel Pfeffer verquirlen.",
        "Nudeln abgießen (etwas Nudelwasser aufheben) und in die Pfanne geben.",
        "Pfanne vom Herd nehmen, Ei-Käse-Mischung unterrühren, mit Nudelwasser cremig rühren."
      ],
      "notes": "Die Pfanne muss vom Herd sein, sonst gibt es Rührei!"
    },
