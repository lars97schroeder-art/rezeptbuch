    {
      "id": "kuerbissuppe",
      "title": "Kürbissuppe mit Ingwer",
      "category": "Eintöpfe & Suppen",
      "time": "40 Min.",
      "servings": "4 Portionen",
      "image": "",
      "ingredients": [
        "1 Hokkaido-Kürbis",
        "1 Zwiebel",
        "1 Stück Ingwer (ca. 2 cm)",
        "800 ml Gemüsebrühe",
        "200 ml Kokosmilch",
        "Salz, Pfeffer, Muskat",
        "Kürbiskerne zum Bestreuen"
      ],
      "steps": [
        "Kürbis waschen, entkernen und in Würfel schneiden (Hokkaido muss nicht geschält werden).",
        "Zwiebel und Ingwer fein hacken und in etwas Öl glasig dünsten.",
        "Kürbis dazugeben, kurz mitbraten, mit Brühe ablöschen.",
        "Ca. 20 Minuten köcheln, bis der Kürbis weich ist.",
        "Kokosmilch dazu, fein pürieren und abschmecken.",
        "Mit gerösteten Kürbiskernen servieren."
      ],
      "notes": ""
    },
