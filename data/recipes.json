    {
      "id": "pfannkuchen",
      "title": "Klassische Pfannkuchen",
      "category": "Süßes",
      "time": "30 Min.",
      "servings": "ca. 8 Stück",
      "image": "",
      "ingredients": [
        "250 g Mehl",
        "500 ml Milch",
        "3 Eier",
        "1 Prise Salz",
        "1 EL Zucker",
        "Butter zum Braten"
      ],
      "steps": [
        "Alle Zutaten zu einem glatten Teig verrühren.",
        "Teig 15 Minuten quellen lassen.",
        "Butter in der Pfanne erhitzen, dünn Teig hineingeben.",
        "Von beiden Seiten goldbraun backen.",
        "Mit Apfelmus, Zimtzucker oder Nutella servieren."
      ],
      "notes": "Der Teig sollte dünnflüssig sein – notfalls etwas Milch nachgießen."
    }
